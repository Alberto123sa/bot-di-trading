+
+    def status_line(self) -> str:
+        eq = self.current_equity()
+        best = self.latest_routes[0].net_edge_bps if self.latest_routes else D0
+        state = "BACKOFF" if self.rest.is_degraded() else "OK"
+        return (
+            f"{utc_text()} | STATUS | EQ={fnum(eq,4)} CASH_PNL={fnum(self.closed_pnl,4)} "
+            f"LIVE={fnum(self.live_notional_now,2)} CICLI={len(self.closed_cycles)} "
+            f"TURN={fnum(self.turnover,2)} TOPEDGE={fnum(best,2)}bp API={state} "
+            f"403/429={self.rest.waf_events} timeout={self.rest.timeout_events}"
+        )
+
+    # -------------------- run --------------------
+
+    def run(self) -> None:
+        self.fetch_exchange_info()
+        print(
+            f"{utc_text()} | [UNIVERSE] cross-quote assets={len(self.universe_assets)} "
+            f"stable_fx={','.join(sorted(self.stable_symbols.values())) or 'NONE'}"
+        )
+        print(f"{utc_text()} | [DEMO ONLY] nessuna chiave privata; nessun endpoint ordini; capitale={self.capital}")
+
+        while not self.stop_event.is_set():
+            loop_start = time.time()
+            try:
+                self.handle_api_resume()
+                if not self.rest.is_degraded() and time.time() - self.last_book_refresh >= self.args.book_refresh:
+                    if self.fetch_all_books():
+                        with self.lock:
+                            self.scan_routes()
+                            self.maybe_execute_stable_triangle()
+
+                if not self.rest.is_degraded() and time.time() - getattr(self, "_last_tape_poll", 0.0) >= self.args.tape_poll:
+                    with self.lock:
+                        self.poll_one_tape()
+                    self._last_tape_poll = time.time()
+
+                now = time.time()
+                if now - self.last_status_ts >= self.args.status:
+                    with self.lock:
+                        print(self.status_line())
+                    self.last_status_ts = now
+                if now - self.last_report_ts >= self.args.report:
+                    with self.lock:
+                        print(self.report())
+                        self.save_state()
+                    self.last_report_ts = now
+            except KeyboardInterrupt:
+                self.stop_event.set()
+            except APIDegraded:
+                pass
+            except Exception as e:
+                print(f"{utc_text()} | [LOOP ERROR] {type(e).__name__}: {e}")
+
+            sleep_for = max(0.05, self.args.poll - (time.time() - loop_start))
+            self.stop_event.wait(sleep_for)
+
+        with self.lock:
+            self.update_live_integral()
+            self.live_orders.clear()
+            self.live_notional_now = D0
+            self.save_state()
+        print(f"{utc_text()} | [STOP] DEMO terminato; nessun ordine reale da cancellare")
+
