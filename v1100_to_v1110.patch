+            lines.append("  ASSET       CICLI   W/L       TURNOVER       LORDO        FEES        NETTO    EDGEavg")
+            for asset, st in sorted(self.asset_stats.items(), key=lambda kv: kv[1].pnl, reverse=True):
+                if st.cycles <= 0:
+                    continue
+                e = st.pnl / st.turnover * BPS if st.turnover > 0 else D0
+                lines.append(
+                    f"  {asset[:10]:10s} {st.cycles:6d} {st.wins:3d}/{st.losses:<3d} "
+                    f"{fnum(st.turnover,2):>12s} {fnum(st.gross,5):>11s} {fnum(st.fees,5):>11s} "
