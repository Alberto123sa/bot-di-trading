+            if self.stable_stats.cycles:
+                st = self.stable_stats
+                e = st.pnl / st.turnover * BPS if st.turnover > 0 else D0
+                lines.append(
+                    f"  {'STABLE':10s} {st.cycles:6d} {st.wins:3d}/{st.losses:<3d} "
+                    f"{fnum(st.turnover,2):>12s} {fnum(st.gross,5):>11s} {fnum(st.fees,5):>11s} "
+                    f"{fnum(st.pnl,5):>11s} {fnum(e,3):>9s}"
