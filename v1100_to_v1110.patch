+                else:
+                    bk = self.books[sym]
+                    sig_parts.append(f"{sym}:{bk.bid}:{bk.ask}")
+            sig = hashlib.sha256("|".join(sig_parts).encode()).hexdigest()
+            key = "->".join(p)
+            if self.last_triangle_signature.get(key) == sig:
+                self.stable_triangle_skips_stale += 1
+                continue
+            if best is None or pnl > best[0]:
+                best = (pnl, fees, detail + " | sig=" + sig, p)
+
+        if best is None:
+            return
+        pnl, fees, detail_sig, path = best
+        detail, sig = detail_sig.rsplit(" | sig=", 1)
+        self.last_triangle_signature["->".join(path)] = sig
+        self.last_triangle = time.time()
+        gross = pnl + fees
+        edge = pnl / size * BPS
+        self.record_cycle(
+            ClosedCycle(
+                ts=time.time(),
+                kind="STABLE",
+                asset="STABLE",
+                route=detail,
+                size_usdc=size,
+                pnl_usdc=pnl,
+                gross_usdc=gross,
+                fees_usdc=fees,
+                armed_edge_bps=edge,
+                realized_edge_bps=edge,
+                edge_decay_bps=D0,
+                transient_ms=0,
+            )
+        )
+        self.stable_triangles += 1
+
+    # -------------------- state / accounting / report --------------------
+
+    def save_state(self) -> None:
+        payload = {
+            "version": VERSION,
+            "ts": time.time(),
+            "capital": str(self.capital),
+            "closed_pnl": str(self.closed_pnl),
+            "closed_gross": str(self.closed_gross),
+            "fee_cost": str(self.fee_cost),
+            "turnover": str(self.turnover),
+            "cycles": len(self.closed_cycles),
+            "note": "summary only; restart intentionally does not restore live maker queues",
+        }
+        tmp = self.state_path.with_suffix(self.state_path.suffix + ".tmp")
+        tmp.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+        os.replace(tmp, self.state_path)
+
+    def current_equity(self) -> Decimal:
+        # No persistent volatile inventory by architecture. Only closed cash PNL counts.
+        return self.capital + self.closed_pnl
+
+    def avg_live_notional(self) -> Decimal:
+        self.update_live_integral()
+        elapsed = max(1.0, time.time() - self.start_ts)
+        return self.avg_live_integral / dec(elapsed)
+
+    def report(self) -> str:
+        with self.lock:
+            eq = self.current_equity()
+            pnl = self.closed_pnl
+            elapsed = max(1.0, time.time() - self.start_ts)
+            avg_live = self.avg_live_notional()
+            monthly_seconds = Decimal(str(30 * 24 * 3600))
+            proj = pnl / dec(elapsed) * monthly_seconds if elapsed >= 6 * 3600 else None
+            proj_pct = pct_value(proj, self.capital) if proj is not None else None
+            eff = pct_value(proj, avg_live) if proj is not None and avg_live > 0 else None
+            wins = sum(s.wins for s in self.asset_stats.values()) + self.stable_stats.wins
+            losses = sum(s.losses for s in self.asset_stats.values()) + self.stable_stats.losses
+            cycles = wins + losses
+            avg_edge = pnl / self.turnover * BPS if self.turnover > 0 else D0
+            decay_sum = sum((c.edge_decay_bps for c in self.closed_cycles), D0)
+            avg_decay = decay_sum / dec(len(self.closed_cycles)) if self.closed_cycles else D0
+
+            lines = []
+            lines.append("=" * 160)
