+def self_test() -> None:
+    src = Path(__file__).read_text(encoding="utf-8")
+    runtime_src = src.split("# -------------------- deterministic self-test --------------------", 1)[0]
+    assert "/api/v3/order" not in runtime_src, "real-order endpoint trovato nel runtime"
+    assert "create_order" not in runtime_src and "place_order" not in runtime_src
+    assert "/api/v3/exchangeInfo" in runtime_src
+    assert "/api/v3/ticker/bookTicker" in runtime_src
+    assert "/api/v3/aggTrades" in runtime_src
+    assert "/api/v3/tradeFee" in __doc__, "private fee requirement must be documented"
+
+    p = build_parser()
+    a = p.parse_args([])
+    a.fee_override = "USD1USDC=0/0,BTCUSDT=1.25/5"
+    fe = FeeEngine(a)
+    assert fe.overrides["USD1USDC"] == (D0, D0)
+    assert fe.overrides["BTCUSDT"] == (Decimal("1.25"), Decimal("5"))
+    ma, ta, src_name = fe.apply("USD1USDC", "0.01", "0.01")
+    assert ma == 0 and ta == 0 and src_name == "override"
+    ma, ta, src_name = fe.apply("ETHUSDT", "0.0002", "0.0005")
+    assert ma == Decimal("2") and ta == Decimal("5") and src_name == "exchangeInfo"
+
+    fields = {f.name for f in dataclasses.fields(ClosedCycle)}
+    assert "open_base_qty" not in fields
+    assert "pnl_usdc" in fields and "fees_usdc" in fields
+
+    x = Decimal("100")
+    fee = Decimal("5") / BPS
+    assert x * (D1 - fee) == Decimal("99.9500")
+    assert set(STABLES) == {"USDC", "USDT", "USD1"}
+
+    # V11.1 structural checks: busy tape windows must be split, not discarded; stable-maker exists.
+    assert "startTime" in runtime_src and "endTime" in runtime_src
+    assert "_fetch_tape_window" in runtime_src and "tape_windows_split" in runtime_src
+    assert "stable_maker_route" in runtime_src and "execute_stable_maker_fill" in runtime_src
+    assert "score_usdc_per_fill" in runtime_src
+
+    print(f"SELF-TEST {BOT_NAME}: SUPERATO")
+    print("  OK DEMO-only | OK global scanner | OK fee engine | OK closed-cycle invariant")
+    print("  OK tape-window split | OK stable-maker closed hedge | OK capacity-score | OK WAF-safe REST")
