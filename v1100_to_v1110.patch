+            lines.append(f"  Commissioni simulate totali                   : {fnum(self.fee_cost,6)} USDC")
+            lines.append("  Inventario volatile aperto                    : 0.000000 USDC | VINCOLO ARCHITETTURALE")
+            lines.append(f"  Cicli chiusi                                  : {cycles} | vincenti {wins} | perdenti {losses}")
+            lines.append(f"  Volume/turnover cicli chiusi                  : {fnum(self.turnover,2)} USDC")
+            lines.append(
+                f"  Edge realizzato medio                         : {fnum(avg_edge,3)} bp/ciclo | decadimento vs edge armato {fnum(avg_decay,3)} bp"
+            )
