+    def stable_path_convert(self, amount: Decimal, path: Sequence[str], exclude_symbol: str = "") -> Optional[Tuple[Decimal, Decimal, Decimal, List[str]]]:
+        """Execute a stable-only taker path on current top books.
+        Returns (output, fee_usdc_approx, max_input_capacity, symbols).
+        The path is linear at top-of-book; max_input_capacity is expressed in the path input currency.
+        """
+        if amount < 0 or len(path) < 2:
+            return None
+        amt = amount
+        fee_usdc = D0
+        cap0 = Decimal("1e50")
+        used: List[str] = []
+        input_scale = D1
+        for i, (a, b) in enumerate(zip(path[:-1], path[1:])):
+            sym = self.stable_symbols.get(frozenset((a, b)))
+            if not sym or sym == exclude_symbol or sym not in self.books or sym not in self.meta:
+                return None
+            r = self.convert_taker(amt, a, b)
+            if r is None:
+                return None
+            out, _, cap_input, rsym = r
+            if rsym == exclude_symbol:
+                return None
+            # Translate this leg's input capacity back to original path input units.
+            if i == 0:
+                cap0 = min(cap0, cap_input)
+            elif input_scale > 0:
+                cap0 = min(cap0, cap_input / input_scale)
+            input_usdc = self._stable_to_usdc_no_fee(amt, a) or D0
+            fee_usdc += input_usdc * self.fee_fraction(self.meta[rsym].taker_bps)
+            if amount > 0:
+                input_scale = out / amount
+            amt = out
+            used.append(rsym)
+        return amt, fee_usdc, cap0, used
