+            lines.append("  ASSET      ROUTE                 NETbp   SCORE$   GROSSbp   FEEbp   BUFFER   CAP_USDC   MAKER / HEDGE")
+            for r in self.latest_routes[: self.args.report_top]:
+                route_txt = f"{r.quote_in}->{r.quote_out}"
+                lines.append(
+                    f"  {r.asset[:10]:10s} {route_txt:20s} {fnum(r.net_edge_bps,3):>9s} {fnum(r.score_usdc_per_fill,4):>8s} "
+                    f"{fnum(r.gross_edge_bps,3):>9s} {fnum(r.fee_bps,3):>7s} "
+                    f"{fnum(r.buffer_bps,3):>8s} {fnum(r.capacity_usdc,2):>10s}   {r.maker_symbol} / {r.hedge_symbol}"
