+            lines.append(
+                f"  Capitale riservato adesso                     : {fnum(self.live_notional_now,2)} USDC | {fnum(pct_value(self.live_notional_now,self.capital),2)}%"
+            )
+            lines.append(
+                f"  Capitale riservato medio                      : {fnum(avg_live,2)} USDC | {fnum(pct_value(avg_live,self.capital),2)}%"
+            )
+            lines.append(
+                f"  Picco capitale riservato                      : {fnum(self.max_live_notional,2)} USDC | {fnum(pct_value(self.max_live_notional,self.capital),2)}%"
+            )
